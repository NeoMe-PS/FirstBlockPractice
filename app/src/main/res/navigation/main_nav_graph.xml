<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_authorizationFragment"
            app:destination="@id/authorizationFragment" />
    </fragment>
    <fragment
        android:id="@+id/authorizationFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.auth.AuthorizationFragment"
        android:label="fragment_authorization"
        tools:layout="@layout/fragment_authorization">
        <action
            android:id="@+id/action_authorizationFragment_to_helpFragment2"
            app:destination="@id/helpFragment" />
    </fragment>
    <fragment
        android:id="@+id/helpFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.help.HelpFragment"
        android:label="fragment_help"
        tools:layout="@layout/fragment_help" />
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.user.EditProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile">
        <action
            android:id="@+id/action_editProfileFragment_to_editImageDialog"
            app:destination="@id/editImageDialog" />
    </fragment>
    <fragment
        android:id="@+id/eventsSearchFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.search.EventsSearchFragment"
        android:label="fragment_events_search"
        tools:layout="@layout/fragment_events_search" />
    <fragment
        android:id="@+id/filterFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.news.FilterFragment"
        android:label="fragment_filter"
        tools:layout="@layout/fragment_filter" />
    <dialog
        android:id="@+id/editImageDialog"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.user.EditImageDialog"
        android:label="EditImageDialog" />
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.history.HistoryFragment"
        android:label="fragment_history"
        tools:layout="@layout/fragment_history" />
    <fragment
        android:id="@+id/newsFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.news.NewsFragment"
        android:label="fragment_news"
        tools:layout="@layout/fragment_news">
        <action
            android:id="@+id/action_newsFragment_to_filterFragment"
            app:destination="@id/filterFragment" />
        <action
            android:id="@+id/action_newsFragment_to_newsDetailFragment"
            app:destination="@id/newsDetailFragment">
            <argument
                android:name="event"
                app:argType="com.ps_pn.firstblockpractice.presentation.models.Event" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/newsDetailFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.news.NewsDetailFragment"
        android:label="fragment_news_detail"
        tools:layout="@layout/fragment_news_detail" />
    <fragment
        android:id="@+id/orgSearchFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.search.OrgSearchFragment"
        android:label="fragment_org_search"
        tools:layout="@layout/fragment_org_search" />
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.search.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" />
    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.ps_pn.firstblockpractice.presentation.fragments.user.UserProfileFragment"
        android:label="fragment_user_profile"
        tools:layout="@layout/fragment_user_profile">
        <action
            android:id="@+id/action_userProfileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

</navigation>