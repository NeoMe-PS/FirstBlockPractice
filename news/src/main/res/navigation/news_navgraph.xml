<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_navgraph"
    app:startDestination="@id/newsFragment">

    <fragment
        android:id="@+id/newsFragment"
        android:name="com.psbn.news.presentation.ui.NewsFragment"
        android:label="NewsFragment">
        <action
            android:id="@+id/action_newsFragment_to_filterFragment"
            app:destination="@id/filterFragment" />
        <action
            android:id="@+id/action_newsFragment_to_newsDetailFragment"
            app:destination="@id/newsDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/newsDetailFragment"
        android:name="com.psbn.news.presentation.ui.NewsDetailFragment"
        android:label="NewsDetailFragment">
        <action
            android:id="@+id/action_newsDetailFragment_to_newsFragment"
            app:destination="@id/newsFragment" />
        <argument
            android:name="event"
            app:argType="com.psbn.news.presentation.models.EventUI" />

    </fragment>
    <fragment
        android:id="@+id/filterFragment"
        android:name="com.psbn.news.presentation.ui.FilterFragment"
        android:label="FilterFragment">
        <action
            android:id="@+id/action_filterFragment_to_newsFragment"
            app:destination="@id/newsFragment" />
    </fragment>
</navigation>